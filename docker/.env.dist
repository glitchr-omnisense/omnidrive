# The harness's settings: copy to .env (git-ignored). Nothing is needed: the
# servers are the harness's own (compose.yml), with throwaway accounts.

# Where the providers' checkouts are, when this core sits in the workspace
# beside them (../.. from this directory); unset, they come from GitHub.
#OMNIDRIVE_PLUGINS=../..

# Servers of your own instead of the harness's (bare --live and the live tests
# then use them; each test works under a directory of its own and removes it).
#OMNIDRIVE_S3_ENDPOINT=https://s3.fr-par.scw.cloud
#OMNIDRIVE_S3_REGION=fr-par
#OMNIDRIVE_S3_BUCKET=
#OMNIDRIVE_S3_KEY=
#OMNIDRIVE_S3_SECRET=
#OMNIDRIVE_S3_PATH_STYLE=0
#OMNIDRIVE_SFTP_HOST=
#OMNIDRIVE_SFTP_PORT=22
#OMNIDRIVE_SFTP_USERNAME=
#OMNIDRIVE_SFTP_PASSWORD=
#OMNIDRIVE_SFTP_ROOT=/
#OMNIDRIVE_FTP_HOST=
#OMNIDRIVE_FTP_USERNAME=
#OMNIDRIVE_FTP_PASSWORD=
#OMNIDRIVE_FTP_ROOT=/
#OMNIDRIVE_WEBDAV_URI=https://cloud.example.org/remote.php/dav/files/<user>/
#OMNIDRIVE_WEBDAV_USERNAME=
#OMNIDRIVE_WEBDAV_PASSWORD=
#OMNIDRIVE_AZURE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
#OMNIDRIVE_AZURE_CONTAINER=omnidrive

# Dropbox and Google Drive: no server stands in for them; with these, their live tests and
# bare --live reach the account (in a folder of its own: OMNIDRIVE_*_PREFIX / _ROOT).
#OMNIDRIVE_DROPBOX_REFRESH_TOKEN=
#OMNIDRIVE_DROPBOX_APP_KEY=
#OMNIDRIVE_DROPBOX_APP_SECRET=
#OMNIDRIVE_DROPBOX_PREFIX=omnidrive-live
#OMNIDRIVE_GDRIVE_CLIENT_ID=
#OMNIDRIVE_GDRIVE_CLIENT_SECRET=
#OMNIDRIVE_GDRIVE_REFRESH_TOKEN=
#OMNIDRIVE_GDRIVE_SERVICE_ACCOUNT=
#OMNIDRIVE_GDRIVE_SHARED_DRIVE_ID=
#OMNIDRIVE_GDRIVE_ROOT=omnidrive-live
