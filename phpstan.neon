# PHPStan at the highest level. phpstan-baseline.neon lists the violations accepted when the
# package started (2026-10-23: the bare report's JSON, read as mixed in Tests/BareTest.php): the CI
# fails on any other.
includes:
    - phpstan-baseline.neon

parameters:
    level: max
    paths:
        - .
    excludePaths:
        - vendor
        - docker
    reportUnmatchedIgnoredErrors: false
